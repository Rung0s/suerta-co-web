    {
      "source": "/it/blog/google-isletme-profili",
      "destination": "/it/blog/profilo-attivita-google",
      "permanent": true
    },
    {
      "source": "/it/blog/whatsapp-chatbot",
      "destination": "/it/blog/chatbot-whatsapp",
      "permanent": true
    },
    {
      "source": "/en/blog/telegram-sinav-botu",
      "destination": "/en/blog/telegram-exam-bot",
      "permanent": true
    },
    {
      "source": "/it/blog/telegram-sinav-botu",
      "destination": "/it/blog/bot-esami-telegram",
      "permanent": true
    },
    {
      "source": "/en/blog/geo-yapay-zeka-gorunurluk",
      "destination": "/en/blog/what-is-geo-ai-visibility",
      "permanent": true
    },
    {
      "source": "/it/blog/geo-yapay-zeka-gorunurluk",
      "destination": "/it/blog/cos-e-la-geo-visibilita-ai",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://cloud.umami.is; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self' https://cloud.umami.is https://api-gateway.umami.dev https://formspree.io; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), autoplay=(self), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), xr-spatial-tracking=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/video/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
