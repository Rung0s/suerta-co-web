    },
    {
      "source": "/it/blog/karanlik-mod-premium",
      "destination": "/it/blog/modalita-scura-premium",
      "permanent": true
    },
    {
      "source": "/en/blog/ozel-yazilim-vs-hazir-paketler",
      "destination": "/en/blog/custom-software-vs-off-the-shelf",
      "permanent": true
    },
    {
      "source": "/it/blog/ozel-yazilim-vs-hazir-paketler",
