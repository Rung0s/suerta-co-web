      "permanent": true
    },
    {
      "source": "/en/blog/mobil-optimizasyon",
      "destination": "/en/blog/mobile-optimisation",
      "permanent": true
    },
    {
      "source": "/it/blog/mobil-optimizasyon",
      "destination": "/it/blog/ottimizzazione-mobile",
      "permanent": true
    },
    {
      "source": "/en/blog/google-ads-donusum",
      "destination": "/en/blog/google-ads-conversion-tracking",
