# Olcum — Umami Cloud (https://cloud.umami.is)
# Panelde site ekledikten sonra Settings > Websites > (site) > Edit ekraninda
# duran "Website ID". Bos birakilirsa olcum tamamen kapali kalir.
VITE_UMAMI_ID=

# Kendi Umami kurulumun varsa script adresi. Bos birakilirsa Umami Cloud.
# VITE_UMAMI_SRC=https://cloud.umami.is/script.js

# Iletisim formu — Formspree (https://formspree.io)
# Yeni form actiktan sonra verilen adresin son parcasi:
# https://formspree.io/f/xxxxxxxx  ->  buraya xxxxxxxx yaziliyor.
# Bos birakilirsa form eski davranisina donuyor ve WhatsApp'a aciyor.
VITE_FORMSPREE_ID=
